# Copy this file to .env and fill in your real key. docker-compose.yml reads
# .env automatically -- see its header comment. Without this set, /agent/chat
# (Phase 9's engineer agent) returns a clean 401 instead of crashing; every
# other endpoint works fine without it.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
